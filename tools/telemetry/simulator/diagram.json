  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp:3V3", "suhu:VCC", "red", [] ],
    [ "esp:GND.1", "suhu:GND", "black", [] ],
    [ "esp:D4", "suhu:DQ", "green", [] ],
    [ "esp:3V3", "pullup:1", "red", [] ],
    [ "pullup:2", "suhu:DQ", "green", [] ],
    [ "esp:VIN", "gas:VCC", "red", [] ],
    [ "esp:GND.1", "gas:GND", "black", [] ],
    [ "esp:GND.1", "gasLevel:GND", "black", [] ],
    [ "gas:AOUT", "gasLevel:A5V", "orange", [] ],
    [ "gas:DOUT", "gasLevel:D5V", "purple", [] ],
    [ "gasLevel:A3V", "esp:D34", "orange", [] ],
    [ "gasLevel:D3V", "esp:D27", "purple", [] ],
    [ "esp:D25", "ledResistor:1", "red", [] ],
    [ "ledResistor:2", "alarmLed:A", "red", [] ],
    [ "alarmLed:C", "esp:GND.1", "black", [] ],
    [ "esp:D26", "alarmBuzzer:2", "red", [] ],
    [ "alarmBuzzer:1", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
