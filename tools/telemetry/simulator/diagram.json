{
  "version": 1,
  "author": "Projek Akhir Kriptografi",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ds18b20", "id": "suhu", "top": -5, "left": 230, "attrs": { "temperature": "25" } },
    { "type": "wokwi-resistor", "id": "pullup", "top": -50, "left": 170, "attrs": { "value": "4700" } },
    { "type": "wokwi-gas-sensor", "id": "gas", "top": 160, "left": 270, "attrs": { "ppm": "0.1", "threshold": "4.4" } },
    { "type": "chip-mq2-level", "id": "gasLevel", "top": 200, "left": 140, "attrs": {} },
    { "type": "wokwi-led", "id": "alarmLed", "top": -100, "left": -110, "attrs": { "color": "red", "label": "Alarm" } },
    { "type": "wokwi-resistor", "id": "ledResistor", "top": -45, "left": -130, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "alarmBuzzer", "top": 110, "left": -140, "attrs": { "volume": "0.1" } }
