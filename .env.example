# Salin menjadi .env dan isi nilai lokal. Password/token gunakan hex acak.
# Monitoring LXC. Jalur utama memakai receiver PQC dan broker privat infra/mqtt.
# Tiga variabel MQTT di bawah hanya untuk compose.legacy.yaml (rollback manual).
# Hostname DNS EMQX lama, tanpa ssl:// atau :8883; boleh kosong pada jalur utama.
MQTT_HOST=
MQTT_TELEGRAF_USERNAME=telegraf-meja01
MQTT_TELEGRAF_PASSWORD=
INFLUX_USERNAME=admin-lab
INFLUX_PASSWORD=
INFLUX_TOKEN=
GRAFANA_USERNAME=admin-lab
GRAFANA_PASSWORD=
# Default lokal; pada LXC isi IP privat server untuk akses dashboard dari LAN/VPN.
GRAFANA_BIND_ADDRESS=127.0.0.1
